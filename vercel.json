{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/api/journal$",
      "dest": "/api/journal"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/health"
    },
    {
      "src": "^/api/mt5/status$",
      "dest": "/api/mt5_status"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
